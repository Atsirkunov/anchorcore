# Copy to hosting/.env — Team self-hosted (one Rust container).
# Everything is optional except the license (the image refuses to boot without
# one) and ANCHOR_AUTH_SECRET whenever the app is reachable beyond localhost
# (a non-loopback Team boot without it is refused — see Logins below).
# ANCHOR_DATA_DIR / ANCHOR_SECRETS_NO_KEYRING are already set by the image.

# Access URL(s) — required when you reach the app via LAN/VPC IP or a domain
# (Host/Origin allowlist). http://localhost:8000 always works.
ANCHOR_CORS_ORIGINS=http://localhost:8000,https://anchorcore.example.com

# Team license — option A: mount a file and point at it
# (docker-compose.yml has the matching volume line).
# ANCHOR_LICENSE_FILE=/data/license.json
# Option B: paste the license JSON inline.
# ANCHOR_LICENSE={"payload": {"org": "...", "edition": "team", "issued": "2026-10-10", "maintenance_until": "2027-10-10", "key_id": "..."}, "signature": "..."}

# Logins — REQUIRED on any non-loopback bind (Team refuses to boot without
# it); enables /auth (signup/login, HS256 JWT) for team use.
# Generate: openssl rand -hex 32
# ANCHOR_AUTH_SECRET=replace-me-with-32-random-bytes
# ANCHOR_AUTH_TOKEN_HOURS=168

# Models. Embeddings work out of the box: the image ships the built-in
# nomic-embed-text v1.5 (CPU). When the host's Ollama serves nomic-embed-text,
# `auto` uses it instead (faster bulk indexing; identical vectors).
# Ingest never uses a chat model (decisions/actions come from record rules).
ANCHOR_OLLAMA_BASE_URL=http://host.docker.internal:11434
ANCHOR_EMBED_MODEL=nomic-embed-text
# The host Ollama is your own machine, not a cloud: trust it so sensitive/pii
# sources still embed through it (only localhost is trusted by default).
ANCHOR_TRUSTED_PROVIDERS=http://host.docker.internal:11434
# Force one engine: builtin (never Ollama) or ollama. Default auto.
# ANCHOR_EMBED_PROVIDER=builtin
# Who writes answers: local (answer model below, default) or agent (your AI
# agent over MCP/REST composes from cited evidence; no chat model here).
# ANCHOR_LLM_MODE=local
# ANCHOR_ANSWER_MODEL=llama3.2:3b
# ANCHOR_ANSWER_BASE_URL=https://api.openai.com/v1
# ANCHOR_ANSWER_API_KEY=sk-...

# Smoke only — boot without a license (NOT for production).
# ANCHOR_EDITION=personal
