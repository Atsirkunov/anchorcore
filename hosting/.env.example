# Copy to hosting/.env and fill. The hosted app is same code, env-driven.
# See backend/.env.example for full list of ANCHOR_* keys.
ANCHOR_DATABASE_URL=postgresql+psycopg://anchorcore:anchorcore@db:5432/anchorcore
ANCHOR_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://anchorcore.example.com
ANCHOR_DATA_DIR=/data
ANCHOR_SECRETS_NO_KEYRING=1

# Hosted auth — set to enable /auth (signup/login). Leave empty for local no-auth.
# Generate: openssl rand -hex 32
ANCHOR_AUTH_SECRET=change-me-to-a-random-hex-string
ANCHOR_AUTH_TOKEN_HOURS=168

# Models — same as local: Ollama or cloud.
ANCHOR_OLLAMA_BASE_URL=http://host.docker.internal:11434
ANCHOR_CLASSIFIER_MODEL=llama3.2:3b
ANCHOR_EMBED_MODEL=nomic-embed-text
ANCHOR_ANSWER_BASE_URL=https://api.openai.com/v1
ANCHOR_ANSWER_API_KEY=sk-...

# Later: object storage for Drive uploads, bundled keys, etc.
# ANCHOR_S3_BUCKET=anchorcore-uploads
# ANCHOR_S3_REGION=eu-central-1
