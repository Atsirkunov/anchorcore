# Copy to hosting/.env — Team self-hosted (one Rust container).
# Everything is optional except the license (the image refuses to boot without
# one). ANCHOR_DATA_DIR / ANCHOR_SECRETS_NO_KEYRING are already set by the image.

# Access URL(s) — required when you reach the app via LAN/VPC IP or a domain
# (Host/Origin allowlist). http://localhost:8000 always works.
ANCHOR_CORS_ORIGINS=http://localhost:8000,https://anchorcore.example.com

# Team license — option A: mount a file and point at it
# (docker-compose.yml has the matching volume line).
# ANCHOR_LICENSE_FILE=/data/license.json
# Option B: paste the license JSON inline.
# ANCHOR_LICENSE={"payload": {"org": "...", "edition": "team", "issued": "2026-10-10", "maintenance_until": "2027-10-10", "key_id": "..."}, "signature": "..."}

# Logins — set to enable /auth (signup/login, HS256 JWT) for team use.
# Generate: openssl rand -hex 32
# ANCHOR_AUTH_SECRET=replace-me-with-32-random-bytes
# ANCHOR_AUTH_TOKEN_HOURS=168

# Models — same as local: Ollama on the host or any OpenAI-compatible cloud API.
ANCHOR_OLLAMA_BASE_URL=http://host.docker.internal:11434
ANCHOR_CLASSIFIER_MODEL=llama3.2:3b
ANCHOR_EMBED_MODEL=nomic-embed-text
# ANCHOR_ANSWER_BASE_URL=https://api.openai.com/v1
# ANCHOR_ANSWER_API_KEY=sk-...

# Smoke only — boot without a license (NOT for production).
# ANCHOR_EDITION=personal
