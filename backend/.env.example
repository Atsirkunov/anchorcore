# Copy to .env and adjust.

# Data + database (defaults: ./data, sqlite)
ANCHOR_DATA_DIR=data
# ANCHOR_DATABASE_URL=sqlite:///./data/anchorcore.db

# UI origin for CORS (Vite dev server)
ANCHOR_CORS_ORIGINS=http://localhost:5173

# Local models (Ollama)
ANCHOR_OLLAMA_BASE_URL=http://localhost:11434
ANCHOR_CLASSIFIER_MODEL=llama3.2:3b
ANCHOR_EMBED_MODEL=nomic-embed-text
# Parallel classification windows sent to Ollama at once (default 4).
# Match the Ollama server's OLLAMA_NUM_PARALLEL so requests aren't queued.
ANCHOR_CLASSIFIER_CONCURRENCY=4

# Answer model (BYO key, OpenAI-compatible).
# Cloud: set API key, e.g. ANCHOR_ANSWER_MODEL=gpt-4o-mini, ANCHOR_ANSWER_API_KEY=sk-...
# Or point at local Ollama for fully offline answers:
#   ANCHOR_ANSWER_BASE_URL=http://localhost:11434/v1
#   ANCHOR_ANSWER_MODEL=llama3.2:3b
# NOTE: these are DEFAULTS only — the Settings tab (app_settings table)
# overrides them at runtime without restart. Secrets set in the UI live in
# the OS keychain, never here.
ANCHOR_ANSWER_MODEL=llama3.2:3b
ANCHOR_ANSWER_API_KEY=
ANCHOR_ANSWER_BASE_URL=http://localhost:11434/v1

# Retrieval
# Max chars per full-document chunk; sections are split at heading lines
# (§434, 4.2.1, Article 12) and kept whole up to this size.
ANCHOR_CHUNK_MAX_CHARS=1600
# RRF fusion (score = Σ w / (60 + rank) per retriever list).
# Keyword list weight: 1.0 = equal with vector; 0 = pure vector.
ANCHOR_RETRIEVAL_KEYWORD_WEIGHT=1.0
# Max chunks per source in final results (diversity; one doc can't monopolize).
ANCHOR_RETRIEVAL_MAX_PER_SOURCE=3
# Recency halflife in days for age decay (newer wins on ties).
ANCHOR_RETRIEVAL_AGE_HALFLIFE_DAYS=365
# Neighboring chunks pulled around a winning chunk (context expansion), per side.
ANCHOR_RETRIEVAL_CONTEXT_WINDOW=1

# Sync
ANCHOR_JIRA_POLL_MINUTES=15
ANCHOR_FOLDER_SCAN_MINUTES=60
ANCHOR_FOLDER_WATCH_DEBOUNCE=3.0

# --- Ollama server tuning (env vars on the Ollama host, NOT this file) ---
# Windows: set as user env vars and restart Ollama (Ollama must be running
# before the app boots; start.ps1 starts it if it isn't):
#   OLLAMA_NUM_PARALLEL=4          # match ANCHOR_CLASSIFIER_CONCURRENCY — without
#                                  # this, parallel requests just queue at the server
#   OLLAMA_CONTEXT_LENGTH=8192     # classifier windows need ~2.5k tokens; the 32k+
#                                  # default wastes KV cache memory
#   OLLAMA_KEEP_ALIVE=30m          # avoid model unload churn between long jobs
# macOS/Linux: export the same vars before running `ollama serve`.
