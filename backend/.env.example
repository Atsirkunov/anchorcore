# Copy to .env and adjust.
ANCHOR_DATABASE_URL=sqlite:///./anchorcore.db
ANCHOR_CORS_ORIGINS=http://localhost:3000

# Classifier: OpenAI-compatible endpoint. Point at Ollama locally,
# or a cloud provider (set ANCHOR_CLASSIFIER_API_KEY + base URL).
ANCHOR_CLASSIFIER_BASE_URL=http://localhost:11434/v1
ANCHOR_CLASSIFIER_MODEL=llama3.2
ANCHOR_CLASSIFIER_API_KEY=ollama
ANCHOR_CLASSIFIER_TIMEOUT=60.0
