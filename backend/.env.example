# Copy to .env and adjust.

# Data + database (defaults: ./data, sqlite)
ANCHOR_DATA_DIR=data
# ANCHOR_DATABASE_URL=sqlite:///./data/anchorcore.db

# UI origin for CORS (Vite dev server)
ANCHOR_CORS_ORIGINS=http://localhost:5173

# Local models (Ollama)
ANCHOR_OLLAMA_BASE_URL=http://localhost:11434
ANCHOR_CLASSIFIER_MODEL=llama3.2:3b
ANCHOR_EMBED_MODEL=nomic-embed-text

# Answer model (BYO key, OpenAI-compatible)
ANCHOR_ANSWER_MODEL=gpt-4o-mini
ANCHOR_ANSWER_API_KEY=
ANCHOR_ANSWER_BASE_URL=https://api.openai.com/v1

# Sync
ANCHOR_JIRA_POLL_MINUTES=15
ANCHOR_FOLDER_SCAN_MINUTES=60
