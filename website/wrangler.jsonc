// AnchorCore website — Workers Static Assets (B47).
// Deploy: npm run build && npx wrangler deploy
// Custom domain anchorcore.dev is attached post-deploy (Workers account domains API).
{
  "name": "anchorcore-website",
  "compatibility_date": "2026-10-09",
  "assets": {
    "directory": "./dist",
    // resolve /privacy to privacy.html (R18.11 route); pinned so the clean
    // URLs the footer and consent line use cannot depend on a default
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "anchorcore.dev/*", "zone_name": "anchorcore.dev" }
  ]
}
